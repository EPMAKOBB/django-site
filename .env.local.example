# Локальная разработка. Скопируйте в .env.local или просто запустите
# start-local.cmd: скрипт создаст .env.local автоматически.
LOCAL_DB_NAME=fractalschool_local
LOCAL_DB_USER=fractalschool_local
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=55438
LOCAL_SITE_HOST=127.0.0.1
LOCAL_SITE_PORT=8001

# Необязательно: каталог bin установленного PostgreSQL.
# LOCAL_PG_BIN=C:\Program Files\PostgreSQL\17\bin
